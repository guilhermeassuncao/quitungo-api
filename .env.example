# ------------------------------------------------------------
# Servidor
# ------------------------------------------------------------
HOST=0.0.0.0
PORT=1337

# ------------------------------------------------------------
# Segredos do Strapi
# Copie da aba Environment do serviço no Render.
# Precisam ser IGUAIS aos de produção se você apontar para o
# mesmo banco, senão o login do admin e os API Tokens falham.
# ------------------------------------------------------------
APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
JWT_SECRET=

# ------------------------------------------------------------
# Banco de dados
# Opção A (recomendada): Postgres do Supabase, igual produção.
#   DATABASE_CLIENT=postgres e DATABASE_URL copiado do Render.
# Opção B: SQLite local vazio, sem conteúdo.
#   DATABASE_CLIENT=sqlite e DATABASE_FILENAME=.tmp/data.db
# ------------------------------------------------------------
DATABASE_CLIENT=postgres
DATABASE_URL=
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=false
# DATABASE_FILENAME=.tmp/data.db

# ------------------------------------------------------------
# Upload de mídia (Cloudinary)
# Copie da aba Environment do serviço no Render.
# ------------------------------------------------------------
CLOUDINARY_NAME=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=

# ------------------------------------------------------------
# Deploy automático do site ao editar conteúdo (opcional)
# Token fine-grained do GitHub com permissão "Actions: Read and write"
# apenas no repositório do site. Sem ele, o site só atualiza com
# deploy manual.
# ------------------------------------------------------------
GITHUB_DEPLOY_TOKEN=
GITHUB_DEPLOY_REPO=guilhermeassuncao/quitungo-astro
