{
  "kind": "collectionType",
  "collectionName": "paginas",
  "info": {
    "singularName": "pagina",
    "pluralName": "paginas",
    "displayName": "Páginas",
    "description": "Cada post do acervo"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "Titulo": {
      "type": "string",
      "required": true
    },
    "Autoria": {
      "type": "string"
    },
    "Ano": {
      "type": "string"
    },
    "Referencia": {
      "type": "text"
    },
    "Capa": {
      "type": "component",
      "repeatable": false,
      "component": "pagina.imagem",
      "required": true
    },
    "categorias": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::categoria.categoria",
      "required": true
    },
    "Conteudo": {
      "type": "dynamiczone",
      "components": [
        "pagina.titulo",
        "pagina.texto",
        "pagina.imagem",
        "pagina.video",
        "pagina.galeria",
        "pagina.documento",
        "pagina.audio",
        "pagina.youtube",
        "pagina.midia"
      ],
      "required": true
    }
  }
}
